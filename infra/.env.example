# VeloDesk VPS Environment Configuration
# Copie este arquivo para .env na VPS da Staycloud

# Porta do Servidor de Sinalização HTTP / WebSocket
PORT=8080

# Chave secreta HMAC compartilhada entre o servidor de sinalização e o Coturn
# IMPORTANTE: Gere uma string aleatória forte (ex: openssl rand -hex 32)
TURN_SECRET=velodesk_super_secret_turn_key_change_in_production

# Realm do servidor TURN (domínio ou IP público)
TURN_REALM=turn.velodesk.staycloud.com

# URLs expostas aos clientes para ICE Servers
STUN_URL=stun:turn.velodesk.staycloud.com:3478
TURN_URL=turn:turn.velodesk.staycloud.com:3478

# Tempo de expiração das credenciais efêmeras do TURN (em segundos, padrão 24 horas = 86400)
TURN_TTL_SECONDS=86400
